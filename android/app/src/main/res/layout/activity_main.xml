<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <!-- Header: Sentovara banner with the app name and whether protection is on. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="64dp"
                android:layout_height="62dp"
                android:contentDescription="@string/logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/sentovara_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/by_sentovara"
                    android:textColor="@color/teal_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Setup / protection card. -->
        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/setup_title"
                style="@style/CardTitle" />

            <TextView
                android:id="@+id/setup_body"
                style="@style/Body" />

            <TextView
                android:id="@+id/step1"
                style="@style/Body"
                android:layout_marginTop="16dp"
                android:text="@string/step1"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/api_key"
                style="@style/Input"
                android:hint="@string/api_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/save_key"
                style="@style/ButtonSecondary"
                android:text="@string/save_key" />

            <TextView
                android:id="@+id/key_status"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/step2"
                style="@style/Body"
                android:layout_marginTop="18dp"
                android:text="@string/step2"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/step2_body"
                style="@style/Body"
                android:text="@string/auto_check_help" />

            <Button
                android:id="@+id/start_protection"
                style="@style/ButtonPrimary"
                android:text="@string/start_protection" />

            <Switch
                android:id="@+id/auto_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:text="@string/auto_check"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Check a message yourself. -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/check_title" />

            <TextView
                style="@style/Body"
                android:text="@string/check_body" />

            <EditText
                android:id="@+id/message"
                style="@style/Input"
                android:gravity="top|start"
                android:hint="@string/paste_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minLines="4" />

            <Button
                android:id="@+id/check"
                style="@style/ButtonPrimary"
                android:text="@string/check" />

            <LinearLayout
                android:id="@+id/verdict_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/verdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Body"
            android:layout_marginTop="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/privacy"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
